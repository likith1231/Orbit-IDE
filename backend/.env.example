# ─── Database ────────────────────────────────────────────────────────────────
# e.g. postgresql://username:password@localhost:5432/orbit
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/orbit"
# Separate database for `npm test` (it gets wiped).
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/orbit_test"

# ─── Auth ────────────────────────────────────────────────────────────────────
# Required in production. Generate with: openssl rand -hex 64
JWT_SECRET="change-me"
# Set to false after creating your own account so strangers can't sign up.
SIGNUP_ENABLED=true

# ─── Claude (AI assistant) ───────────────────────────────────────────────────
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=""
# Default chat model (users can switch in the UI). Options: claude-opus-5-5, claude-sonnet-5-5, claude-haiku-4-5
CLAUDE_MODEL="claude-opus-5-5"
# Model for inline autocomplete (runs on every typing pause, so keep it fast and cheap).
CLAUDE_FAST_MODEL="claude-haiku-4-5"

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=5000
# 127.0.0.1 when running behind a reverse proxy (production); 0.0.0.0 for local dev.
HOST=0.0.0.0
# Comma-separated list of frontend origins allowed to call the API.
CORS_ORIGINS="http://localhost:5173,https://orbit-ide-rho.vercel.app"

# ─── Docker / terminal ───────────────────────────────────────────────────────
# Where workspaces and sandboxes live on disk. If the backend runs in Docker, mount this
# directory at the SAME path inside the container (see docker-compose.yml).
# DATA_DIR=/var/lib/orbit
# auto | docker | local | off   (auto = docker if available, else local in dev, off in prod)
TERMINAL_MODE=auto
# Built from docker/terminal.Dockerfile; falls back to node:20-bookworm-slim if missing.
TERMINAL_IMAGE="orbit-terminal:latest"
# Stop a project's terminal container after this many idle minutes.
TERMINAL_IDLE_MINUTES=20
# Optional Docker Hub mirror, handy if you hit pull rate limits.
# DOCKER_IMAGE_MIRROR="mirror.gcr.io"
