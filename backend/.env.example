# PostgreSQL Database URL for your main development database.
# e.g., postgresql://username:password@localhost:5432/ai_ide
DATABASE_URL="your_database_url_here"

# PostgreSQL Database URL for running backend integration tests (should be separate from main).
# e.g., postgresql://username:password@localhost:5432/ai_ide_test
TEST_DATABASE_URL="your_test_database_url_here"

# Secret key used to sign JSON Web Tokens (JWT) for authentication.
# Generate a random string using `openssl rand -hex 64`.
JWT_SECRET="your_jwt_secret_here"

# Google Gemini API Key for the AI assistant and auto-debugger capabilities.
# Get a free Gemini API key at https://aistudio.google.com/apikey
GEMINI_API_KEY="your_gemini_api_key_here"

# Port on which the Express backend will run (default is 5000)
PORT="5000"
