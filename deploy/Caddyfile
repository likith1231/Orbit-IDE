# Caddy terminates HTTPS (free Let's Encrypt certificate, renewed automatically)
# and forwards everything to the backend on localhost.
{$DOMAIN} {
	encode zstd gzip
	reverse_proxy 127.0.0.1:{$BACKEND_PORT:5000} {
		# Stream AI responses (Server-Sent Events) without buffering.
		flush_interval -1
	}
}

# Other apps on this VM (e.g. AetherMed, GhostOps) drop their sites into /etc/caddy-sites.
import /etc/caddy/sites/*.caddy
