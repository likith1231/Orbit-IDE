# Copy to the repo root as .env (next to docker-compose.yml) and fill in.

# Public hostname for the API. No domain? Use your VM's public IP with sslip.io,
# e.g. for IP 129.146.10.20:  DOMAIN=129-146-10-20.sslip.io
DOMAIN=

# openssl rand -hex 24
POSTGRES_PASSWORD=
# openssl rand -hex 64
JWT_SECRET=

ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Your frontend URL(s), comma-separated.
CORS_ORIGINS=https://orbit-ide-rho.vercel.app

# Set to false after you've created your account.
SIGNUP_ENABLED=true
